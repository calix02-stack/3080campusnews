[{"id": "b0d1123e-c573-4f3f-84c5-c98b1aca6566", "subject_id": "ofp", "subject_name": "Office Practice", "type": "cbt", "year": null, "text": "The process of arranging and storing records for easy retrieval is called:", "options": ["Filing", "Indexing", "Sorting", "Archiving"], "correct_answer": 0, "explanation": "Filing is the systematic arrangement and storage of records for easy retrieval.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "424b4b06-7caa-47d5-9866-db7668b8c7d9", "subject_id": "ofp", "subject_name": "Office Practice", "type": "cbt", "year": null, "text": "Which of the following is a filing equipment?", "options": ["Filing cabinet", "Typewriter", "Computer", "Printer"], "correct_answer": 0, "explanation": "A filing cabinet is equipment used for storing files and documents.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "bd4f1f32-6324-4052-a4ad-2a3af87ffb39", "subject_id": "ofp", "subject_name": "Office Practice", "type": "cbt", "year": null, "text": "The person responsible for the overall management of an office is the:", "options": ["Office manager", "Secretary", "Clerk", "Receptionist"], "correct_answer": 0, "explanation": "The office manager oversees the overall running of the office.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "132c05a8-99ef-4da9-8280-ef0f0b09f5d0", "subject_id": "ofp", "subject_name": "Office Practice", "type": "cbt", "year": null, "text": "Which of these is a means of communication in an office?", "options": ["Memo", "File", "Cabinet", "Desk"], "correct_answer": 0, "explanation": "A memo (memorandum) is an internal communication document used in offices.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "e693404b-0e14-46cc-a4be-48ee4dab2553", "subject_id": "ofp", "subject_name": "Office Practice", "type": "cbt", "year": null, "text": "The term \"incoming mail\" refers to:", "options": ["Letters received in the office", "Letters sent from the office", "Internal memos", "Fax messages"], "correct_answer": 0, "explanation": "Incoming mail refers to letters and documents received by the office.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "433aaddc-1aa0-4be6-8729-c42682728c88", "subject_id": "ofp", "subject_name": "Office Practice", "type": "cbt", "year": null, "text": "Which of these is a modern office equipment?", "options": ["Computer", "Typewriter", "File cabinet", "Desk"], "correct_answer": 0, "explanation": "A computer is a modern office equipment used for various tasks.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "625cf7da-6b86-48b5-918f-ee2a160f8bb3", "subject_id": "ofp", "subject_name": "Office Practice", "type": "cbt", "year": null, "text": "The process of recording business transactions in a systematic manner is:", "options": ["Bookkeeping", "Filing", "Indexing", "Sorting"], "correct_answer": 0, "explanation": "Bookkeeping is the systematic recording of financial transactions.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "34c56d26-5f5f-4e81-b061-18675b7df405", "subject_id": "ofp", "subject_name": "Office Practice", "type": "cbt", "year": null, "text": "A document that serves as evidence of a business transaction is called:", "options": ["Source document", "File", "Memo", "Letter"], "correct_answer": 0, "explanation": "A source document provides evidence of a business transaction.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "4884709e-7fd8-4816-8706-aaeb800becf4", "subject_id": "ofp", "subject_name": "Office Practice", "type": "cbt", "year": null, "text": "The person who welcomes visitors and answers telephone calls in an office is the:", "options": ["Receptionist", "Secretary", "Manager", "Clerk"], "correct_answer": 0, "explanation": "A receptionist handles visitors and telephone calls.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "c466bb33-5d2f-440a-8b68-824a65433a7b", "subject_id": "ofp", "subject_name": "Office Practice", "type": "cbt", "year": null, "text": "Which filing method uses alphabetical arrangement?", "options": ["Alphabetic filing", "Numeric filing", "Geographic filing", "Subject filing"], "correct_answer": 0, "explanation": "Alphabetic filing arranges files in alphabetical order.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "d6986e8b-0673-4001-b946-81bc8ad5eda7", "subject_id": "ofp", "subject_name": "Office Practice", "type": "cbt", "year": null, "text": "The daily record of cash received and paid out is called:", "options": ["Cash book", "Ledger", "Journal", "Trial balance"], "correct_answer": 0, "explanation": "A cash book records all cash transactions.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "036a0bb2-5d5b-4de4-b6fd-cc34fca0cc64", "subject_id": "ofp", "subject_name": "Office Practice", "type": "cbt", "year": null, "text": "Which of these is a type of office layout?", "options": ["Open plan", "Closed plan", "Executive plan", "Standard plan"], "correct_answer": 0, "explanation": "Open plan is a type of office layout where there are no fixed walls between workstations.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "9c8bda6f-cfb9-4fd0-bc51-e82da90f5293", "subject_id": "ofp", "subject_name": "Office Practice", "type": "cbt", "year": null, "text": "A letter sent within the same organization is called:", "options": ["Memorandum", "Letter", "Report", "Circular"], "correct_answer": 0, "explanation": "A memorandum is used for internal communication.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "2791ebe8-48a5-43dd-ba1b-eea77ddc90dc", "subject_id": "ofp", "subject_name": "Office Practice", "type": "cbt", "year": null, "text": "The process of checking recorded data for accuracy is called:", "options": ["Verification", "Approval", "Authorization", "Certification"], "correct_answer": 0, "explanation": 