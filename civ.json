[{"id": "dfd84a8a-b9b8-42d7-bd08-a51f2d0d6383", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The supreme law of Nigeria is the:", "options": ["Constitution", "Criminal code", "Civil code", "Sharia law"], "correct_answer": 0, "explanation": "The Constitution is the supreme law of Nigeria.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "0e9924ee-d771-452b-8ef5-c8d4fde7a23a", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The right to vote is called:", "options": ["Suffrage", "Franchise", "Caucus", "Primaries"], "correct_answer": 0, "explanation": "Suffrage is the right to vote.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "a625deb7-9139-4242-aec3-e75a831ea73d", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian National Assembly is made up of:", "options": ["Senate and House of Representatives", "House of Chiefs", "National Council", "Federal Cabinet"], "correct_answer": 0, "explanation": "The National Assembly consists of the Senate and House of Representatives.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "0176622f-da17-4ba8-86e8-db70e67ad43e", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The President of Nigeria is the:", "options": ["Head of State", "Chief Justice", "Speaker", "Senate President"], "correct_answer": 0, "explanation": "The President is the Head of State.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "9e928b45-a407-4111-9461-1856e1dc676f", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian flag has how many colors?", "options": ["3", "2", "4", "5"], "correct_answer": 0, "explanation": "The Nigerian flag has 3 colors - Green, White, Green.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "d1f96c4f-6758-46aa-b530-09c6987789a2", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The green color on the Nigerian flag represents:", "options": ["Agriculture", "Peace", "Unity", "Strength"], "correct_answer": 0, "explanation": "Green represents agriculture.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "e86fe2cd-0197-4e25-a372-ea2bba5b87ff", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The white color on the Nigerian flag represents:", "options": ["Peace", "Agriculture", "Unity", "Strength"], "correct_answer": 0, "explanation": "White represents peace.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "8e056e98-457e-41ea-8a29-6a58917e7b5f", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian national anthem has how many stanzas?", "options": ["2", "3", "4", "5"], "correct_answer": 0, "explanation": "The Nigerian national anthem has 2 stanzas.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "c930b9fa-d7f7-4f6f-b595-dedacef026bc", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The concept of \"rule of law\" means:", "options": ["Nobody is above the law", "Only citizens follow the law", "The president makes the law", "The law changes daily"], "correct_answer": 0, "explanation": "Rule of law means nobody is above the law.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "1d62d544-f50d-4628-a676-1c54ea3cdf8a", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The local government is the:", "options": ["Third tier of government", "First tier of government", "Second tier of government", "Fourth tier of government"], "correct_answer": 0, "explanation": "Local government is the third tier.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "4d994cf7-3b31-47a0-b23d-4777ca146f36", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "Human rights are rights that belong to:", "options": ["All human beings", "Only citizens", "Only men", "Only women"], "correct_answer": 0, "explanation": "Human rights belong to all human beings.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "e1a10843-777a-47ab-aff4-482e01b177e9", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The right to life is a:", "options": ["Fundamental human right", "Political right", "Social right", "Economic right"], "correct_answer": 0, "explanation": "The right to life is a fundamental human right.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "0d8cd4cc-4b89-4736-901f-92377949eb0e", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian Police Force is responsible for:", "options": ["Maintaining law and order", "Collecting taxes", "Building roads", "Running schools"], "correct_answer": 0, "explanation": "The Police maintain law and order.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "9691383a-279e-40fd-a5ac-628913ae6943", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The judiciary is responsible for:", "options": ["Interpreting the law", "Making the law", "Enforcing the law", "Writing the constitution"], "correct_answer": 0, "explanation": "The judiciary interprets the law.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "67794cfb-5d80-4614-a518-faa153ded762", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The legislature is responsible for:", "options": ["Making the law", "Interpreting the law", "Enforcing the law", "Running the government"], "correct_answer": 0, "explanation": "The legislature makes the law.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "764cb982-2342-4df4-adcf-2d3b99a9a854", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The executive is responsible for:", "options": ["Enforcing the law", "Making the law", "Interpreting the law", "Writing the constitution"], "correct_answer": 0, "explanation": "The executive enforces the law.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "38c3986f-c001-4bb3-98a6-2121e816d42b", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Federal Capital Territory (FCT) is:", "options": ["Abuja", "Lagos", "Kano", "Port Harcourt"], "correct_answer": 0, "explanation": "Abuja is the Federal Capital Territory.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "a12c3804-1b37-49f3-9795-92dd1d97dc0f", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The number of states in Nigeria is:", "options": ["36", "37", "38", "35"], "correct_answer": 0, "explanation": "Nigeria has 36 states.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "819947e0-c105-4297-8f6c-589ef0c291fd", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian constitution was last amended in:", "options": ["1999", "2010", "2015", "2020"], "correct_answer": 0, "explanation": "The constitution was last amended in 1999.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "c01d3998-6baa-4c53-96cf-0ef90607bb3b", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The citizenship of Nigeria can be acquired by:", "options": ["Birth, descent, registration, naturalization", "Only by birth", "Only by marriage", "Only by registration"], "correct_answer": 0, "explanation": "Citizenship can be acquired by birth, descent, registration, and naturalization.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "dd57f4f1-d800-46fd-8dfa-69f1a006bf7d", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian Senate has how many members?", "options": ["109", "360", "45", "100"], "correct_answer": 0, "explanation": "The Senate has 109 members.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "a4c04eea-65ca-4b6c-afd9-43313b7f9ca6", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The House of Representatives has how many members?", "options": ["360", "109", "45", "100"], "correct_answer": 0, "explanation": "The House of Representatives has 360 members.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "bbf0f345-fec7-4b45-8c38-1c9ba98fccc0", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The concept of \"democracy\" means:", "options": ["Government by the people", "Government by one person", "Government by the military", "Government by the elite"], "correct_answer": 0, "explanation": "Democracy is government by the people.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "84d4637d-939d-4071-98d0-575f7158f811", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The right to free speech is a:", "options": ["Fundamental human right", "Political right", "Social right", "Economic right"], "correct_answer": 0, "explanation": "Free speech is a fundamental human right.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "830b2aab-349a-4632-82c3-831184cad9c0", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The right to education is a:", "options": ["Social right", "Political right", "Economic right", "Civil right"], "correct_answer": 0, "explanation": "Education is a social right.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "2e853d48-3900-4044-849b-c14e9b4e1a7b", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian president is elected for a term of:", "options": ["4 years", "5 years", "6 years", "3 years"], "correct_answer": 0, "explanation": "The president serves a 4-year term.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "18ac7c18-d535-4860-b72d-6eb8d3cf6cbc", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The maximum number of terms a Nigerian president can serve is:", "options": ["2", "1", "3", "Unlimited"], "correct_answer": 0, "explanation": "A Nigerian president can serve a maximum of 2 terms.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "785f41f8-b5e1-440e-a541-bb520cf8e919", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The courts in Nigeria are part of the:", "options": ["Judiciary", "Legislature", "Executive", "Civil service"], "correct_answer": 0, "explanation": "Courts are part of the judiciary.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "e32cc073-04b1-431a-bae5-67341bc2db40", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The chief justice of Nigeria is appointed by the:", "options": ["President", "Senate", "National Assembly", "Chief Judge"], "correct_answer": 0, "explanation": "The President appoints the chief justice.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "0437812f-a2c6-41af-9967-be37f291bee0", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The National Youth Service Corps (NYSC) was established in:", "options": ["1973", "1960", "1970", "1980"], "correct_answer": 0, "explanation": "NYSC was established in 1973.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "aa1da708-29b9-4b4b-8be3-453adeaf679b", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The purpose of NYSC is to:", "options": ["Promote unity", "Create employment", "Collect taxes", "Build roads"], "correct_answer": 0, "explanation": "NYSC promotes national unity.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "1210476f-c1c7-4370-851e-8809d354e404", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Armed Forces of Nigeria include:", "options": ["Army, Navy, Air Force", "Army only", "Police and Army", "Civil Defense"], "correct_answer": 0, "explanation": "The Armed Forces include Army, Navy, and Air Force.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "8996895c-3c71-4eb1-a2bc-fe26cdb6a8cc", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Chief of Army Staff is appointed by the:", "options": ["President", "Minister of Defense", "National Assembly", "Army Council"], "correct_answer": 0, "explanation": "The President appoints the Chief of Army Staff.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "5f4275d5-317e-4da4-9199-dc4d7e717482", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian constitution provides for:", "options": ["Federalism", "Unitary system", "Confederal system", "Monarchy"], "correct_answer": 0, "explanation": "The constitution provides for federalism.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "4431bba6-980a-4f60-94ea-d498b2160226", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The concept of \"federal character\" means:", "options": ["Representation of all groups", "Only one group is represented", "The military rules", "No representation"], "correct_answer": 0, "explanation": "Federal character ensures representation of all groups.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "de5c7501-10df-4744-9297-5b1c6e2b3d62", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Ministry of Education is responsible for:", "options": ["Education policy", "Health policy", "Defense policy", "Finance policy"], "correct_answer": 0, "explanation": "The Ministry of Education handles education policy.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "fe29b634-ce2c-422f-81ab-515f5ef485bd", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Ministry of Health is responsible for:", "options": ["Health policy", "Education policy", "Defense policy", "Finance policy"], "correct_answer": 0, "explanation": "The Ministry of Health handles health policy.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "24d8340f-0d11-444c-b138-f71ed5b5dc93", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian Civil Service is part of the:", "options": ["Executive branch", "Legislative branch", "Judicial branch", "Media"], "correct_answer": 0, "explanation": "The Civil Service is part of the executive branch.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "9fb21a8d-1d23-4ad7-9ee1-26b0020eaa60", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The police force in Nigeria is headed by the:", "options": ["Inspector General of Police", "Chief of Police", "Commissioner of Police", "President"], "correct_answer": 0, "explanation": "The Inspector General of Police heads the police force.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "6e9d675b-4fcb-41c9-a539-54734134270a", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian army is headed by the:", "options": ["Chief of Army Staff", "President", "Minister of Defense", "National Assembly"], "correct_answer": 0, "explanation": "The Chief of Army Staff heads the army.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "4ec792e0-045e-499f-a5d3-38464f21891b", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian navy is headed by the:", "options": ["Chief of Naval Staff", "President", "Minister of Defense", "National Assembly"], "correct_answer": 0, "explanation": "The Chief of Naval Staff heads the navy.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "69151d16-f30c-4a3a-a36a-89ba2f8f28ef", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian air force is headed by the:", "options": ["Chief of Air Staff", "President", "Minister of Defense", "National Assembly"], "correct_answer": 0, "explanation": "The Chief of Air Staff heads the air force.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "00660798-1ff9-4e11-ae61-9d9f70d60b8f", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian constitution was adopted in:", "options": ["1999", "1960", "1963", "1979"], "correct_answer": 0, "explanation": "The constitution was adopted in 1999.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "83eef6d8-f17d-4f82-afa1-1cb0cceda731", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The right to a fair hearing is a:", "options": ["Fundamental human right", "Political right", "Social right", "Economic right"], "correct_answer": 0, "explanation": "A fair hearing is a fundamental human right.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "73d660a0-56bf-498e-bc7b-56f29e5d094a", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The right to freedom of movement is a:", "options": ["Fundamental human right", "Political right", "Social right", "Economic right"], "correct_answer": 0, "explanation": "Freedom of movement is a fundamental human right.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "8fe8cdd2-e0c2-4761-9cff-8f5dda80dbd2", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The right to freedom of assembly is a:", "options": ["Fundamental human right", "Political right", "Social right", "Economic right"], "correct_answer": 0, "explanation": "Freedom of assembly is a fundamental human right.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "6b2554ea-c440-46da-a95d-c4a194bb015c", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The right to freedom of association is a:", "options": ["Fundamental human right", "Political right", "Social right", "Economic right"], "correct_answer": 0, "explanation": "Freedom of association is a fundamental human right.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "0bc202bc-cfda-4fd7-976e-325416d73c71", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The right to own property is a:", "options": ["Fundamental human right", "Political right", "Social right", "Economic right"], "correct_answer": 0, "explanation": "The right to own property is a fundamental human right.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "dffbcf0e-4d34-42bf-8837-80493286ad6c", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The concept of \"separation of powers\" means:", "options": ["Division of government into three branches", "One branch has all power", "The military rules", "No government"], "correct_answer": 0, "explanation": "Separation of powers divides government into three branches.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "73142285-4681-4d76-bdc8-cdc6d80d3812", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The National Assembly is the:", "options": ["Legislature of Nigeria", "Executive of Nigeria", "Judiciary of Nigeria", "Armed Forces"], "correct_answer": 0, "explanation": "The National Assembly is the legislature.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "a437a93e-43fa-4ff1-ba53-ff4ca5febaa6", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian president is the:", "options": ["Commander-in-Chief", "Chief Justice", "Senate President", "Speaker"], "correct_answer": 0, "explanation": "The President is the Commander-in-Chief.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "9caa1b22-b1e5-48c0-b071-cec7c8e8c75a", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian flag was designed by:", "options": ["Michael Taiwo Akinkunmi", "Obafemi Awolowo", "Nnamdi Azikiwe", "Tafawa Balewa"], "correct_answer": 0, "explanation": "Michael Taiwo Akinkunmi designed the flag.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "4a744933-61e3-4866-9d25-c954f67c4e04", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian coat of arms features:", "options": ["Two horses and a shield", "An eagle", "A lion", "A dove"], "correct_answer": 0, "explanation": "The coat of arms features two horses and a shield.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "2683696b-7419-4efa-ba93-2d8d62bf2611", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian national pledge begins with:", "options": ["I pledge to Nigeria my country", "I pledge allegiance", "I love my country", "Nigeria is great"], "correct_answer": 0, "explanation": "The pledge begins with \"I pledge to Nigeria my country\".", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "fd88c51f-152b-48ec-b26e-9ede94eddae4", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The concept of \"national unity\" means:", "options": ["Togetherness of all groups", "Division of groups", "Only one group", "No groups"], "correct_answer": 0, "explanation": "National unity means togetherness of all groups.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "3ded9856-5711-4611-bfcc-a876f57c9584", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The concept of \"patriotism\" means:", "options": ["Love of ones country", "Love of oneself", "Love of money", "Love of power"], "correct_answer": 0, "explanation": "Patriotism is love of ones country.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "44d24929-a009-4fc6-b984-086b52b7f689", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The concept of \"citizenship\" means:", "options": ["Membership of a country", "Membership of a club", "Membership of a family", "Membership of a religion"], "correct_answer": 0, "explanation": "Citizenship is membership of a country.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "5e270629-1ad2-4393-a056-d149f246c1de", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The right to vote is also known as:", "options": ["Suffrage", "Franchise", "Both A and B", "Neither A nor B"], "correct_answer": 2, "explanation": "The right to vote is called suffrage or franchise.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "048211e7-32b1-419b-9aef-1dbb47d62c8d", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The National Orientation Agency (NOA) is responsible for:", "options": ["Civic education", "Health education", "Defense", "Finance"], "correct_answer": 0, "explanation": "NOA is responsible for civic education.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "d88a4225-f31f-4ea8-ad39-3dfe81cb35c5", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Independent National Electoral Commission (INEC) is responsible for:", "options": ["Conducting elections", "Building roads", "Collecting taxes", "Running schools"], "correct_answer": 0, "explanation": "INEC conducts elections.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "8c0d863e-d375-4d6c-b26f-2bb6044f8537", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Economic and Financial Crimes Commission (EFCC) is responsible for:", "options": ["Fighting corruption", "Conducting elections", "Building roads", "Running schools"], "correct_answer": 0, "explanation": "EFCC fights corruption.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "b787f861-4b36-480d-b229-26c5b97bf4b6", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Independent Corrupt Practices Commission (ICPC) is responsible for:", "options": ["Fighting corruption", "Conducting elections", "Building roads", "Running schools"], "correct_answer": 0, "explanation": "ICPC fights corruption.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "e7fa4071-e3e6-4496-b97e-29fedef5423a", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Federal Road Safety Corps (FRSC) is responsible for:", "options": ["Road safety", "Conducting elections", "Fighting corruption", "Building roads"], "correct_answer": 0, "explanation": "FRSC is responsible for road safety.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "3e3bc3d6-c282-4a7b-8c36-1a655236e621", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The National Drug Law Enforcement Agency (NDLEA) is responsible for:", "options": ["Fighting drug trafficking", "Conducting elections", "Building roads", "Running schools"], "correct_answer": 0, "explanation": "NDLEA fights drug trafficking.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "63586aa4-5bfd-43d7-8234-5351228791f0", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian Immigration Service is responsible for:", "options": ["Controlling borders", "Conducting elections", "Fighting corruption", "Building roads"], "correct_answer": 0, "explanation": "Immigration controls borders.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "57fa54fc-5ceb-4d5c-8e97-efe230015a1e", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigeria Customs Service is responsible for:", "options": ["Collecting customs duties", "Conducting elections", "Fighting corruption", "Building roads"], "correct_answer": 0, "explanation": "Customs collects duties.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "9feb47db-7954-41e3-9e0f-4cb3064fb4f8", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Nigerian Prisons Service is responsible for:", "options": ["Holding prisoners", "Conducting elections", "Fighting corruption", "Building roads"], "correct_answer": 0, "explanation": "Prisons holds prisoners.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "0226f54f-1540-4678-a876-12880126cdb4", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Code of Conduct Bureau is responsible for:", "options": ["Monitoring public officers", "Conducting elections", "Building roads", "Running schools"], "correct_answer": 0, "explanation": "The Code of Conduct Bureau monitors public officers.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "89bf3e8c-170d-4c2d-8dac-3d3ab4220b3a", "subject_id": "civ", "subject_name": "Civic", "type": "cbt", "year": null, "text": "The Public Complaints Commission is also known as:", "options": ["Ombudsman", "EFCC", "ICPC", "INEC"], "correct_answer": 0, "explanation": "The Public Complaints Commission is also known as Ombudsman.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "c2465534-953d-4303-8055-249501e312a0", "subject_id": "