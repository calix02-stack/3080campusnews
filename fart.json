assage_id": null, "batch_number": 1}, {"id": "a4399161-c81a-427f-adc3-cf97e7b7909c", "subject_id": "fart", "subject_name": "Fine Arts", "type": "cbt", "year": null, "text": "The primary colors are:", "options": ["Red, Blue, Yellow", "Red, Green, Blue", "Cyan, Magenta, Yellow", "Orange, Purple, Green"], "correct_answer": 0, "explanation": "Red, Blue, Yellow are primary colors.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "ea44d682-89ae-487c-86a9-f081088568a7", "subject_id": "fart", "subject_name": "Fine Arts", "type": "cbt", "year": null, "text": "Which sculpture technique involves carving away material?", "options": ["Subtractive", "Additive", "Modeling", "Casting"], "correct_answer": 0, "explanation": "Subtractive sculpture removes material.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "82368471-eb8e-4e04-9daa-3dec5addabde", "subject_id": "fart", "subject_name": "Fine Arts", "type": "cbt", "year": null, "text": "The art movement known for its emphasis on capturing light and atmosphere is:", "options": ["Impressionism", "Cubism", "Surrealism", "Expressionism"], "correct_answer": 0, "explanation": "Impressionism focuses on light and atmosphere.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "73ec9ec8-2305-4346-a4e9-656ba8260f2e", "subject_id": "fart", "subject_name": "Fine Arts", "type": "cbt", "year": null, "text": "A drawing where the artist uses only lines, without shading, is called:", "options": ["Contour drawing", "Gesture drawing", "Still life", "Landscape"], "correct_answer": 0, "explanation": "Contour drawing uses lines to define edges.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "399c6d6e-b257-430d-bd74-2060318b72ff", "subject_id": "fart", "subject_name": "Fine Arts", "type": "cbt", "year": null, "text": "Which color is a secondary color?", "options": ["Green", "Red", "Blue", "Yellow"], "correct_answer": 0, "explanation": "Green is secondary (Blue + Yellow).", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "4546204b-86ee-4d00-87d7-d3c528ce4a98", "subject_id": "fart", "subject_name": "Fine Arts", "type": "cbt", "year": null, "text": "What is the principle of design that creates a sense of movement?", "options": ["Rhythm", "Balance", "Unity", "Contrast"], "correct_answer": 0, "explanation": "Rhythm creates visual movement.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "9c915e29-7060-4519-8963-c8108bf63e3d", "subject_id": "fart", "subject_name": "Fine Arts", "type": "cbt", "year": null, "text": "The painting \"The Starry Night\" was created by:", "options": ["Vincent van Gogh", "Pablo Picasso", "Salvador Dali", "Claude Monet"], "correct_answer": 0, "explanation": "Van Gogh painted The Starry Night.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "21a9ca65-d8ae-4238-98e1-a710181158b8", "subject_id": "fart", "subject_name": "Fine Arts", "type": "cbt", "year": null, "text": "In art, value refers to:", "options": ["Lightness or darkness of a color", "The price of the artwork", "The size of the artwork", "The texture of the artwork"], "correct_answer": 0, "explanation": "Value is the lightness or darkness.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "ac775649-aef7-490c-b6c3-14143dcf4607", "subject_id": "fart", "subject_name": "Fine Arts", "type": "cbt", "year": null, "text": "Which of these is a form of printmaking?", "options": ["Etching", "Oil painting", "Watercolor", "Sculpture"], "correct_answer": 0, "explanation": "Etching is a printmaking technique.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "2d0d968d-75eb-411e-9226-84a2457dcc0a", "subject_id": "fart", "subject_name": "Fine Arts", "type": "cbt", "year": null, "text": "The rule of thirds is a compositional guideline used in:", "options": ["Photography and painting", "Sculpture", "Printmaking", "Architecture"], "correct_answer": 0, "explanation": "The rule of thirds is used in photography and painting.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "d60cc003-e8d3-4d1c-91fa-e9614488a4e3", "subject_id": "fart", "subject_name": "Fine Arts", "type": "cbt", "year": null, "text": "What color is complementary to red?", "options": ["Green", "Blue", "Yellow", "Orange"], "correct_answer": 0, "explanation": "Green is complementary to red.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "826183b1-a5bb-4158-9df0-a35f26ab6b8c", "subject_id": "fart", "subject_name": "Fine Arts", "type": "cbt", "year": null, "text": "The term \"chiaroscuro\" refers to:", "options": ["Strong contrast between light and dark", "The use of bright colors", "A type of brushstroke", "A kind of canvas"], "correct_answer": 0, "explanation": "Chiaroscuro uses strong light/dark contrast.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "60d72112-f421-4d71-8595-53871ce972a4", "subject_id": "fart", "subject_name": "Fine Arts", "type": "cbt", "year": null, "text": "Which ancient civilization is known for its sculpture of the Venus of Willendorf?", "options": ["Paleolithic", "Egyptian", "Greek", "Roman"], "correct_answer": 0, "explanation": "The Venus of Willendorf is Paleolithic.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "15c6e93c-d7c5-4a4f-a366-b5e8770f2232", "subject_id": "fart", "subject_name": "Fine Arts", "type": "cbt", "year": null, "text": "What is the difference between a tint and a shade?", "options": ["Tint is color + white; shade is color + black", "Tint is color + black; shade is color + white", "Tint is pure color; shade is mixed", "There is no difference"], "correct_answer": 0, "explanation": "Tint adds white; shade adds black.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "349c1f16-b9cb-4eee-afbe-0a2662a1d0b3", "subject_id": "fart", "subject_name": "Fine Arts", "type": "cbt", "year": null, "text": "The Bau