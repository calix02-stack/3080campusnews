nce", "type": "cbt", "year": null, "text": "Underwriting in insurance refers to:", "options": ["Risk assessment", "Claim payment", "Premium collection", "Policy issuance"], "correct_answer": 0, "explanation": "Underwriting is risk assessment.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "ea11865c-8664-46c0-ae63-1fe0a9f329cb", "subject_id": "ins", "subject_name": "Insurance", "type": "cbt", "year": null, "text": "Reinsurance is insurance for:", "options": ["Insurers", "Policyholders", "Agents", "Brokers"], "correct_answer": 0, "explanation": "Reinsurance is insurance for insurers.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "e3779fcf-9513-445b-972e-872d7e27cd63", "subject_id": "ins", "subject_name": "Insurance", "type": "cbt", "year": null, "text": "The insured is also known as the:", "options": ["Policyholder", "Insurer", "Agent", "Broker"], "correct_answer": 0, "explanation": "The insured is also known as the policyholder.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "e524a746-f3f2-4f94-91f1-7f0901c40239", "subject_id": "ins", "subject_name": "Insurance", "type": "cbt", "year": null, "text": "The premium is usually paid:", "options": ["Regularly", "Once", "Irregularly", "Never"], "correct_answer": 0, "explanation": "Premium is usually paid regularly.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "09ac34c4-1af0-40b2-8f22-f04275615326", "subject_id": "ins", "subject_name": "Insurance", "type": "cbt", "year": null, "text": "The claim settlement process involves:", "options": ["Investigation and payment", "Rejection", "Delay", "No response"], "correct_answer": 0, "explanation": "Claim settlement involves investigation and payment.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "661555ac-5311-4007-9b1e-e8229a8615ca", "subject_id": "ins", "subject_name": "Insurance", "type": "cbt", "year": null, "text": "The principle of subrogation means:"