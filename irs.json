 1}, {"id": "758f755f-b1a2-4f20-a6be-0a77529bc911", "subject_id": "irs", "subject_name": "IRS", "type": "cbt", "year": null, "text": "The black stone in the Kabah is called:", "options": ["Hajar al-Aswad", "Maqam Ibrahim", "Rukn al-Yamani", "Hijr Ismail"], "correct_answer": 0, "explanation": "Hajar al-Aswad is the black stone.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "debf5864-abda-4f48-877e-6df20ba248d3", "subject_id": "irs", "subject_name": "IRS", "type": "cbt", "year": null, "text": "The station of Abraham in the Kabah is called:", "options": ["Maqam Ibrahim", "Hajar al-Aswad", "Rukn al-Yamani", "Hijr Ismail"], "correct_answer": 0, "explanation": "Maqam Ibrahim is the station of Abraham.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "cfc08249-30d0-42c6-a7a5-8ff7fc230b29", "subject_id": "irs", "subject_name": "IRS", "type": "cbt", "year": null, "text": "The call to prayer in Islam is called:", "options": ["Adhan", "Iqamah", "Tasbih", "Takbir"], "correct_answer": 0, "explanation": "Adhan is the call to prayer.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "237addba-df4d-4739-be86-21fe85cf0758", "subject_id": "irs", "subject_name": "IRS", "type": "cbt", "year": null, "text": "The night of power is called:", "options": ["Laylat al-Qadr", "Laylat al-Miraj", "Laylat al-Baraah", "Laylat al-Arafah"], "correct_answer": 0, "explanation": "Laylat al-Qadr is the night of power.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "b8f38e4d-171e-4293-8180-63265b5de35e", "subject_id": "irs", "subject_name": "IRS", "type": "cbt", "year": null, "text": "Standing on Mount Arafat is part of:", "options": ["Hajj", "Umrah", "Sawm", "Salah"], "correct_answer": 0, "explanation": "Standing on Mount Arafat is part of Hajj.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "e7e780f1-8b79-41f1-bd95-3b3314ea6975", "subject_id": "irs", "subject_name": "IRS", "type": "cbt", "year": null, "text": "Circumambulation of the Kabah is called:", "options": ["Tawaf", "Sai", "Wuquf", "Ramal"], "correct_answer": 0, "explanation": "Tawaf is circumambulation of the Kabah.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "f068a6a0-fbfa-4cfd-96d5-a654cada3376", "subject_id": "irs", "subject_name": "IRS", "type": "cbt", "year": null, "text": "Running between Safa and Marwah is called:", "options": ["Sai", "Tawaf", "Wuquf", "Ramal"], "correct_answer": 0, "explanation": "Sai is running between Safa and Marwah.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "8dfc2782-da13-43fb-a0e9-99053d5ac244", "subject_id": "irs", "subject_name": "IRS", "type": "cbt", "year": null, "text": "The Islamic term for pure intention is:", "options": ["Ikhlas", "Niyyah", "Tawbah", "Taqwa"], "correct_answer": 0, "explanation": "Ikhlas is pure intention.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "ac377364-9ad0-4bab-9a69-5abddc1f3760", "subject_id": "irs", "subject_name": "IRS", "type": "cbt", "year": null, "text": "The Islamic term for repentance is:", "options": ["Tawbah", "Ikhlas", "Niyyah", "Taqwa"], "correct_answer": 0, "explanation": "Tawbah is repentance.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "0dd8460c-2844-43c7-af88-8b195f2e4175", "subject_id": "irs", "subject_name": "IRS", "type": "cbt", "year": null, "text": "The Islamic term for piety is:", "options": ["Taqwa", "Ikhlas", "Niyyah", "Tawbah"], "correct_answer": 0, "explanation": "Taqwa is piety.", "display_order": null, "passage_id": null, "batch_number": 1}, {"id": "a85ca18b-a544-4c07-b4fb-1c35a129b138", "subject_id": "irs", "subject_name": "IRS", "type": "cbt", "year": null, "text": "The Islamic term for love of Allah is:", "options": ["Mahabbah", "Khushu", "Tawakkul", "Sabr"], "correct_answer": 0, "explanation": "Mahabbah is love of Allah.", "display_order": null, "passage_id": null, "batch_number": 1